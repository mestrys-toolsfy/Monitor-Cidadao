# Copie este arquivo para .env.local e preencha com o projeto Supabase.
# Nunca coloque a chave service_role aqui: ela não pode ir para o navegador.

# URL do projeto (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave publicável (Settings → API). Não é a service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel

# Chave do Portal da Transparência (header chave-api-dados). Deixe vazio até cadastrar.
PORTAL_TRANSPARENCIA_CHAVE=
